{
  "compilerOptions": {
    // Language / module settings — Bun runs TypeScript directly, so we never
    // need to emit JS from tsc (the `build` script uses `bun build` instead).
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,

    // Strictness — strict mode is on, plus a few extra safety nets.
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Interop / hygiene.
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Ambient declarations for the Bun runtime/test runner. The project has no
    // dependencies, so these are hand-maintained in types/ambient.d.ts.
    "types": ["./types/ambient.d.ts"]
  },
  "include": ["src", "tests", "types"]
}
