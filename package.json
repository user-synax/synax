{
  "name": "@user-synax/synax",
  "version": "0.0.1",
  "description": "A small scripting language that transpiles to JavaScript.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "language",
    "compiler",
    "transpiler",
    "javascript",
    "bun",
    "synax"
  ],
  "bin": {
    "synax": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./synax.d.ts",
  "exports": {
    ".": {
      "types": "./synax.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "synax.d.ts",
    "synax.html",
    "README.md",
    "LICENSE",
    "SPEC.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts src/index.ts --outdir dist --target bun",
    "docs": "bun run scripts/build-docs.ts",
    "dev": "bun run --watch src/cli.ts",
    "prepublishOnly": "bun test && bun run typecheck && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
